--CREATE DATABASE
CREATE DATABASE [CarSalesDB];
GO

USE [CarSalesDB];
GO


--CREATE TABLE
CREATE TABLE CarSales (
    SaleID INT PRIMARY KEY,
    SaleDate DATE,
    Brand VARCHAR(50),
    Model VARCHAR(50),
    Salesperson VARCHAR(50),
    Region VARCHAR(50),
    QuantitySold INT,
    SellingPrice DECIMAL(12,2),
    PurchasePrice DECIMAL(12,2)
);
