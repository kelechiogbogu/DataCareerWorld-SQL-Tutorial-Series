
-- CREATE DATABASE
CREATE DATABASE [CarSalesDB];
GO

-- SELECT DATABASE
USE [CarSalesDB];
GO

-- CREATE TABLE
CREATE TABLE CarSales (
    SaleID VARCHAR(10) PRIMARY KEY,
    ProductID VARCHAR(10) NOT NULL,
    SaleDate DATE,
    Brand VARCHAR(50),
    Model VARCHAR(50),
    Salesperson VARCHAR(50) NULL,
    Region VARCHAR(50),
    QuantitySold INT,
    SellingPrice DECIMAL(12,2),
    PurchasePrice DECIMAL(12,2)
);
